# ==== Database ====
# Untuk local dev, ini otomatis cocok dengan docker-compose.yml
DATABASE_URL=
POSTGRES_PASSWORD=trackster

# ==== Auth ====
JWT_SECRET=ganti-dengan-random-string-panjang
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-ini

# ==== Owner info (dipakai parser untuk deteksi self-transfer Jago) ====
OWNER_FULL_NAME="XXXX XXXX XXXX"
# Nomor rekening milik sendiri (comma-separated). Transfer Flip/bank ke nomor ini di-exclude.
OWNER_ACCOUNT_NUMBERS=XXXX,XXXX,XXXX

# ==== Gmail API OAuth2 (+ Calendar events for langganan reminders) ====
# Scopes: gmail.readonly + calendar.events — user must reconnect Google after deploy.
# Enable Google Calendar API in the same Cloud project.
# Setup di https://console.cloud.google.com -> APIs & Services -> Credentials
# Redirect URI harus persis: https://api.trackster.my.id/gmail/callback (prod)
# atau http://localhost:4000/gmail/callback (local dev)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:4000/gmail/callback

# ==== AI Trackster (kategorisasi otomatis, chat advisor — terpisah dari AI Split Bill) ====
# 9router self-hosted (OpenAI-compatible), diakses dari container via host.docker.internal
# (lihat extra_hosts di docker-compose.prod.yml). AI_MODEL = chat advisor & narasi.
# AI_MODEL_FAST = tugas pendek seperti kategorisasi transaksi.
AI_BASE_URL=http://host.docker.internal:20128
AI_API_KEY=
AI_MODEL=cc/claude-sonnet-5
AI_MODEL_FAST=cc/claude-haiku-4-5-20251001

# ==== Split Bill scan struk (vision, 9router juga — model boleh beda dari AI_MODEL kalau perlu) ====
SPLITBILL_AI_BASE_URL=http://host.docker.internal:20128
SPLITBILL_AI_API_KEY=
SPLITBILL_AI_MODEL=cc/claude-sonnet-5

# ==== Telegram ====
# Sudah didapat: bot token dari @BotFather, chat ID dari getUpdates
# (disimpan lewat halaman Settings di app, bukan lewat .env)

# ==== URLs ====
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Dipakai sitemap.ts & robots.ts (URL absolut). Default prod = https://trackster.dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BACKEND_PORT=4000

# ==== Production only (docker-compose.prod.yml) ====
# FRONTEND_URL=https://trackster.my.id
# NEXT_PUBLIC_API_URL=https://api.trackster.my.id
# NEXT_PUBLIC_SITE_URL=https://trackster.dev
# GMAIL_REDIRECT_URI=https://api.trackster.my.id/gmail/callback

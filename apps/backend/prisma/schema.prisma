generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Transaction {
  id          Int      @id @default(autoincrement())
  amount      Decimal  @db.Decimal(12, 2)
  description String
  source      Source
  emailId     String   @unique
  occurredAt  DateTime
  createdAt   DateTime @default(now())
  note        String?
  category    Category @default(LAINNYA)

  @@index([occurredAt])
}

enum Source {
  BCA
  JAGO
  GOPAY
}

enum Category {
  MAKANAN
  TRANSPORT
  BELANJA
  TAGIHAN
  HIBURAN
  KESEHATAN
  LAINNYA
}

model DailyBudget {
  id        Int      @id @default(autoincrement())
  dayOfWeek Int      @unique // 0=Minggu ... 6=Sabtu
  amount    Decimal  @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt
}

model EmailSyncLog {
  id         Int      @id @default(autoincrement())
  lastSyncAt DateTime
  status     String // SUCCESS | ERROR
  message    String?
  createdAt  DateTime @default(now())
}

model TelegramConfig {
  id                     Int      @id @default(autoincrement())
  botToken               String
  chatId                 String
  isActive               Boolean  @default(true)
  notifyEveryTransaction Boolean  @default(false)
  updatedAt              DateTime @updatedAt
}

model GmailToken {
  id           Int      @id @default(autoincrement())
  refreshToken String
  email        String
  updatedAt    DateTime @updatedAt
}

model AlertLog {
  id        Int      @id @default(autoincrement())
  date      DateTime @db.Date
  sentAt    DateTime @default(now())

  @@unique([date])
}

model Income {
  id          Int      @id @default(autoincrement())
  amount      Decimal  @db.Decimal(12, 2)
  description String
  source      Source
  receivedAt  DateTime
  createdAt   DateTime @default(now())

  @@index([receivedAt])
}

model BankBalance {
  id            Int      @id @default(autoincrement())
  source        Source   @unique
  balance       Decimal  @db.Decimal(12, 2)
  lastUpdatedAt DateTime @updatedAt
}

// Log tiap kali saldo bergerak lewat koreksi manual (bukan lewat transaksi/income normal) —
// dipakai buat histori "kenapa saldo tiba-tiba beda dari perkiraan".
model BalanceAdjustment {
  id        Int      @id @default(autoincrement())
  source    Source
  delta     Decimal  @db.Decimal(12, 2)
  note      String?
  createdAt DateTime @default(now())

  @@index([source])
}

// Nama panggilan buat merchant, terikat ke Transaction.description via string match (bukan FK) —
// jadi berlaku otomatis ke semua transaksi lama & baru yang description-nya persis sama.
model MerchantAlias {
  id             Int      @id @default(autoincrement())
  rawDescription String   @unique
  displayName    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Split Bill: fitur berdiri sendiri buat bagi tagihan makan bareng teman, SENGAJA tidak
// terhubung ke Transaction/BankBalance sama sekali — lihat CLAUDE.md soal kenapa saldo
// harus tetap "live incremental" tanpa campur tangan alur lain.
model SplitBill {
  id                Int      @id @default(autoincrement())
  publicSlug        String   @unique
  restaurantName    String
  billDate          DateTime
  taxAmount         Decimal  @default(0) @db.Decimal(12, 2)
  serviceFeeAmount  Decimal  @default(0) @db.Decimal(12, 2)
  createdByUserId   Int
  createdAt         DateTime @default(now())

  // Rekening orang yang nalangin duluan — ditampilkan di halaman publik biar temen tau
  // harus transfer ke mana. Semua opsional, kosong berarti nggak ditampilkan.
  payerBankName      String?
  payerAccountNumber String?
  payerAccountName   String?

  participants SplitBillParticipant[]
  items        SplitBillItem[]
}

model SplitBillParticipant {
  id          Int       @id @default(autoincrement())
  splitBillId Int
  splitBill   SplitBill @relation(fields: [splitBillId], references: [id], onDelete: Cascade)
  name        String
  isPaid      Boolean   @default(false)
  paidAt      DateTime?

  items SplitBillItem[]

  @@index([splitBillId])
}

model SplitBillItem {
  id            Int                    @id @default(autoincrement())
  splitBillId   Int
  splitBill     SplitBill              @relation(fields: [splitBillId], references: [id], onDelete: Cascade)
  description   String
  amount        Decimal                @db.Decimal(12, 2) // harga per unit, dikali quantity buat dapet total baris
  quantity      Int                    @default(1)
  participantId Int?
  participant   SplitBillParticipant?  @relation(fields: [participantId], references: [id])

  @@index([splitBillId])
  @@index([participantId])
}
